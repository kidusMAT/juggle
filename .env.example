# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (for PostgreSQL in production)
DATABASE_URL=postgres://user:password@localhost:5432/thejuggle

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379/1

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# HTTPS/SSL
SECURE_SSL_REDIRECT=True
SECURE_SSL_HOST=yourdomain.com

# Cookie Security
DJANGO_COOKIE_SECURE=True

# Chapa Payment Gateway
CHAPA_PUBLIC_KEY=CHAPUBK_TEST_xxxxx
CHAPA_SECRET_KEY=CHASECK_TEST_xxxxx
CHAPA_ENCRYPTION_KEY=your-encryption-key

# URLs
FRONTEND_URL=https://yourdomain.com
SITE_URL=https://api.yourdomain.com

# Google OAuth (Optional)
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
